diff --git a/src/pooling/s3_maxpool_locality.c b/src/pooling/s3_maxpool_locality.c
new file mode 100644
index 0000000..04f5dde
--- /dev/null
+++ b/src/pooling/s3_maxpool_locality.c
@@ -0,0 +1,97 @@
+#include "s3_maxpool_locality.h"
+#include <stdbool.h>
+
+#define COLUMN_BATCH_BYTES 128
+
+unsigned s3_maxpool_locality_mode;
+
+static void column_first(const int8_t *input, int8_t *output, unsigned width,
+                         unsigned height, locality_row_t row, bool stream)
+{
+    /* Two or four 16-byte prefix maxima per group. Limit stack use independent
+     * of tensor dimensions. All groups are processed together up to 128 channels. */
+    _Alignas(16) int8_t history[4 * COLUMN_BATCH_BYTES];
+    __typeof__(s3_maxpool_column_first_asm) *leaf = stream ? s3_maxpool_stream_asm : s3_maxpool_column_first_asm;
+    for (unsigned y = 0; y < height; ++y) {
+        const unsigned top = y > row.pad ? y - row.pad : 0;
+        const unsigned end = y + row.pad + 1;
+        row.rows = (end < height ? end : height) - top;
+        for (unsigned ch = 0; ch < row.channels; ch += COLUMN_BATCH_BYTES) {
+            const unsigned remaining = row.channels - ch;
+            const unsigned batch = remaining < COLUMN_BATCH_BYTES ? remaining : COLUMN_BATCH_BYTES;
+            leaf(input + (size_t) top * row.row_bytes + ch,
+                                        output + (size_t) y * row.row_bytes + ch,
+                                        &row, history, width, batch);
+        }
+    }
+}
+
+void s3_maxpool_locality(const int8_t *input, int8_t *output,
+                        unsigned width, unsigned height, unsigned channels,
+                        unsigned pad, int8_t act_min, int8_t act_max,
+                        unsigned mode)
+{
+    locality_row_t row = {
+        .row_bytes = width * channels, .channels = channels,
+        .activation_min = act_min, .activation_max = act_max, .pad = pad,
+    };
+    const bool fit = mode >= LOC_FIT;
+    const bool whole_row_pair = fit && pad == 1 && channels == 32;
+    if (whole_row_pair) {
+        /* All 32 channels fit in the paired leaf. The entire output row is
+         * one run, so the general tile and channel loops are unnecessary. */
+        const size_t pitch = row.row_bytes;
+        const int8_t *in_row = input;
+        int8_t *out_row = output;
+        row.rows = 2;
+        s3_maxpool_scheduled_pair_asm(in_row, out_row, &row, width, 1, 1);
+        row.rows = 3;
+        for (unsigned y = 1; y + 1 < height; ++y) {
+            out_row += pitch;
+            s3_maxpool_scheduled_pair_asm(in_row, out_row, &row, width, 1, 1);
+            in_row += pitch;
+        }
+        row.rows = 2;
+        s3_maxpool_scheduled_pair_asm(in_row, out_row + pitch, &row, width, 1, 1);
+        return;
+    }
+    if (mode == LOC_COLUMN_FIRST ||
+        (mode >= LOC_STREAM && channels > 16)) {
+        column_first(input, output, width, height, row, mode >= LOC_STREAM);
+        return;
+    }
+
+    const bool scheduled = mode >= LOC_SCHEDULED;
+    const bool row_bands = mode >= LOC_BAND_4 && !scheduled;
+    const unsigned band = row_bands ? 4 : 1;
+    const unsigned tile_mode = row_bands ? mode - LOC_BAND_4 : mode - LOC_TILE_4;
+    const unsigned tile = fit ? width : scheduled ? (pad == 1 ? 32 : 16) : 4u << tile_mode;
+    __typeof__(s3_maxpool_tile_asm) *single = scheduled ? s3_maxpool_scheduled_asm : s3_maxpool_tile_asm;
+    for (unsigned y0 = 0; y0 < height; y0 += band) {
+        const unsigned y_end = y0 + band < height ? y0 + band : height;
+        for (unsigned x = 0; x < width; x += tile) {
+            const unsigned output_end = x + tile < width ? x + tile : width;
+            const unsigned left = x > pad ? x - pad : 0;
+            const unsigned desired_right = output_end + pad;
+            const unsigned right = desired_right < width ? desired_right : width;
+            for (unsigned y = y0; y < y_end; ++y) {
+                const unsigned top = y > pad ? y - pad : 0;
+                const unsigned end = y + pad + 1;
+                row.rows = (end < height ? end : height) - top;
+                const int8_t *in = input + (size_t) top * row.row_bytes + left * channels;
+                int8_t *out = output + (size_t) y * row.row_bytes + x * channels;
+                unsigned ch = 0;
+                if (mode == LOC_PAIRED && pad == 1) {
+                    for (; ch + 32 <= channels; ch += 32) {
+                        s3_maxpool_scheduled_pair_asm(in + ch, out + ch, &row, right - left,
+                                                     x + pad - left, desired_right - right);
+                    }
+                }
+                for (; ch < channels; ch += 16) {
+                    single(in + ch, out + ch, &row, right - left,
+                           x + pad - left, desired_right - right);
+                }
+            }
+        }
+    }
+}
diff --git a/src/pooling/s3_maxpool_locality.h b/src/pooling/s3_maxpool_locality.h
new file mode 100644
index 0000000..3344bfe
--- /dev/null
+++ b/src/pooling/s3_maxpool_locality.h
@@ -0,0 +1,74 @@
+/* Shared C/assembler layout for the experimental max-pool leaves. */
+#ifndef S3_MAXPOOL_LOCALITY_H
+#define S3_MAXPOOL_LOCALITY_H
+
+#define LOC_ROW_BYTES 0
+#define LOC_CHANNELS 4
+#define LOC_ROWS 8
+#define LOC_MIN 12
+#define LOC_MAX 13
+#define LOC_PAD 14
+
+#ifndef __ASSEMBLER__
+#include <stdint.h>
+#include <stddef.h>
+
+typedef struct {
+    uint32_t row_bytes;
+    uint32_t channels;
+    uint32_t rows;
+    int8_t activation_min;
+    int8_t activation_max;
+    uint8_t pad;
+} locality_row_t;
+
+_Static_assert(offsetof(locality_row_t, row_bytes) == LOC_ROW_BYTES, "row bytes offset");
+_Static_assert(offsetof(locality_row_t, channels) == LOC_CHANNELS, "channels offset");
+_Static_assert(offsetof(locality_row_t, rows) == LOC_ROWS, "row count offset");
+_Static_assert(offsetof(locality_row_t, activation_min) == LOC_MIN, "activation min offset");
+_Static_assert(offsetof(locality_row_t, activation_max) == LOC_MAX, "activation max offset");
+_Static_assert(offsetof(locality_row_t, pad) == LOC_PAD, "pad offset");
+
+enum {
+    LOC_CURRENT,
+    LOC_COLUMN_FIRST,
+    LOC_TILE_4,
+    LOC_TILE_8,
+    LOC_TILE_16,
+    LOC_TILE_32,
+    LOC_BAND_4,
+    LOC_BAND_8,
+    LOC_BAND_16,
+    LOC_BAND_32,
+    LOC_SCHEDULED,
+    LOC_PAIRED,
+    LOC_STREAM,
+    LOC_STREAM_RETAIN_SINGLE,
+    LOC_FIT,
+    LOC_FIT_RETAIN_SINGLE,
+    LOC_MODE_COUNT
+};
+
+extern unsigned s3_maxpool_locality_mode;
+
+void s3_maxpool_stream_asm(const int8_t *input, int8_t *output,
+                          const locality_row_t *row, int8_t *scratch,
+                          unsigned width, unsigned batch_bytes);
+void s3_maxpool_column_first_asm(const int8_t *input, int8_t *output,
+                                const locality_row_t *row, int8_t *scratch,
+                                unsigned width, unsigned batch_bytes);
+void s3_maxpool_tile_asm(const int8_t *input, int8_t *output,
+                        const locality_row_t *row, unsigned input_cols,
+                        unsigned skip_cols, unsigned right_cols);
+void s3_maxpool_scheduled_asm(const int8_t *input, int8_t *output,
+                              const locality_row_t *row, unsigned input_cols,
+                              unsigned skip_cols, unsigned right_cols);
+void s3_maxpool_scheduled_pair_asm(const int8_t *input, int8_t *output,
+                                   const locality_row_t *row, unsigned input_cols,
+                                   unsigned skip_cols, unsigned right_cols);
+void s3_maxpool_locality(const int8_t *input, int8_t *output,
+                        unsigned width, unsigned height, unsigned channels,
+                        unsigned pad, int8_t act_min, int8_t act_max,
+                        unsigned mode);
+#endif
+#endif
diff --git a/src/pooling/s3_maxpool_scheduled.S b/src/pooling/s3_maxpool_scheduled.S
new file mode 100644
index 0000000..86b7438
--- /dev/null
+++ b/src/pooling/s3_maxpool_scheduled.S
@@ -0,0 +1,170 @@
+#include "s3_maxpool_locality.h"
+
+    .text
+
+    // Up to four prefix maxima live in q2...q5. q0/q6/q7 are free for
+    // independent loads because this leaf only handles full int8 activation.
+    .macro single_column rows
+    mov.n   a10,a2
+    ee.vld.128.xp q1,a10,a8
+    ee.vld.128.xp q0,a10,a8
+    .if \rows >= 3
+    ee.vld.128.xp q6,a10,a8
+    .endif
+    ee.vmax.s8 q1,q1,q0
+    .if \rows >= 4
+    ee.vld.128.xp q7,a10,a8
+    .endif
+    .if \rows == 5
+    ee.vld.128.xp q0,a10,a8
+    .endif
+    add.n   a2,a2,a11
+    .if \rows >= 3
+    ee.vmax.s8 q1,q1,q6
+    .endif
+    .if \rows == 4
+    ee.vmax.s8 q1,q1,q7
+    .endif
+    .if \rows == 5
+    ee.vmax.s8 q7,q7,q0
+    ee.vmax.s8 q1,q1,q7
+    .endif
+    .endm
+
+    .macro single_history pad
+    .if \pad == 2
+    ee.vmax.s8 q5,q4,q1
+    ee.vmax.s8 q4,q3,q1
+    .endif
+    ee.vmax.s8 q3,q2,q1
+    mv.qr   q2,q1
+    .endm
+
+    .macro single_tile pad, history, rows
+    loopgtz a14,1f
+    single_column \rows
+    single_history \pad
+1:
+    loopgtz a15,2f
+    single_column \rows
+    ee.vmax.s8 q0,\history,q1
+    ee.vst.128.xp q0,a3,a11
+    single_history \pad
+2:
+    beqz    a7,4f
+    .if \pad == 2
+    bltz    a15,3f
+    .endif
+    ee.vst.128.xp \history,a3,a11
+    .if \pad == 2
+    beqi    a7,1,4f
+3:
+    ee.vst.128.xp q4,a3,a11
+    .endif
+4:
+    retw.n
+    .endm
+
+    .align 4
+    .global s3_maxpool_scheduled_asm
+    .type s3_maxpool_scheduled_asm,@function
+s3_maxpool_scheduled_asm:
+    entry   a1,64
+    l32i.n  a8,a4,LOC_ROW_BYTES
+    l32i.n  a9,a4,LOC_ROWS
+    l32i.n  a11,a4,LOC_CHANNELS
+    l8ui    a10,a4,LOC_PAD
+    minu    a14,a5,a6
+    sub     a15,a5,a6
+    movi.n  a13,-128
+    s32i.n  a13,a1,0
+    ee.vldbc.8 q2,a1
+    mv.qr   q3,q2
+    beqi    a10,1,.Lscheduled3
+    mv.qr   q4,q2
+    mv.qr   q5,q2
+    beqi    a9,5,.Lscheduled55
+    beqi    a9,4,.Lscheduled54
+    single_tile 2,q5,3
+.Lscheduled54:
+    single_tile 2,q5,4
+.Lscheduled55:
+    single_tile 2,q5,5
+.Lscheduled3:
+    beqi    a9,3,.Lscheduled33
+    single_tile 1,q3,2
+.Lscheduled33:
+    single_tile 1,q3,3
+    .size s3_maxpool_scheduled_asm,.-s3_maxpool_scheduled_asm
+
+    // Pair two neighboring channel groups for 3x3. Their independent loads
+    // and reductions can overlap, and each output pixel gets adjacent stores.
+    .macro pair_column rows
+    mov.n   a10,a2
+    addi    a13,a2,16
+    ee.vld.128.xp q1,a10,a8
+    ee.vld.128.xp q0,a13,a8
+    ee.vld.128.xp q6,a10,a8
+    ee.vld.128.xp q7,a13,a8
+    ee.vmax.s8 q1,q1,q6
+    ee.vmax.s8 q0,q0,q7
+    .if \rows == 3
+    ee.vld.128.xp q6,a10,a8
+    ee.vld.128.xp q7,a13,a8
+    .endif
+    add.n   a2,a2,a11
+    .if \rows == 3
+    ee.vmax.s8 q1,q1,q6
+    ee.vmax.s8 q0,q0,q7
+    .endif
+    .endm
+
+    .macro pair_history
+    ee.vmax.s8 q3,q2,q1
+    ee.vmax.s8 q5,q4,q0
+    mv.qr   q2,q1
+    mv.qr   q4,q0
+    .endm
+
+    .macro pair_tile rows
+    loopgtz a14,1f
+    pair_column \rows
+    pair_history
+1:
+    loopgtz a15,2f
+    pair_column \rows
+    ee.vmax.s8 q6,q3,q1
+    ee.vmax.s8 q7,q5,q0
+    ee.vst.128.xp q6,a3,a11
+    ee.vst.128.xp q7,a12,a11
+    pair_history
+2:
+    beqz    a7,3f
+    ee.vst.128.xp q3,a3,a11
+    ee.vst.128.xp q5,a12,a11
+3:
+    retw.n
+    .endm
+
+    .align 4
+    .global s3_maxpool_scheduled_pair_asm
+    .type s3_maxpool_scheduled_pair_asm,@function
+s3_maxpool_scheduled_pair_asm:
+    entry   a1,64
+    l32i.n  a8,a4,LOC_ROW_BYTES
+    l32i.n  a9,a4,LOC_ROWS
+    l32i.n  a11,a4,LOC_CHANNELS
+    addi    a12,a3,16
+    minu    a14,a5,a6
+    sub     a15,a5,a6
+    movi.n  a13,-128
+    s32i.n  a13,a1,0
+    ee.vldbc.8 q2,a1
+    mv.qr   q3,q2
+    mv.qr   q4,q2
+    mv.qr   q5,q2
+    beqi    a9,3,.Lpair3
+    pair_tile 2
+.Lpair3:
+    pair_tile 3
+    .size s3_maxpool_scheduled_pair_asm,.-s3_maxpool_scheduled_pair_asm
diff --git a/src/pooling/s3_maxpool_stream.S b/src/pooling/s3_maxpool_stream.S
new file mode 100644
index 0000000..ac2c7eb
--- /dev/null
+++ b/src/pooling/s3_maxpool_stream.S
@@ -0,0 +1,150 @@
+#include "s3_maxpool_locality.h"
+
+    .text
+
+    // In the full-range path the temporary registers are free until the
+    // history is loaded. Issue independent loads before consuming them.
+    .macro stream_vertical rows
+    mov.n   a15,a12
+    ee.vld.128.xp q1,a15,a9
+    ee.vld.128.xp q0,a15,a9
+    .if \rows >= 3
+    ee.vld.128.xp q2,a15,a9
+    .endif
+    ee.vmax.s8 q1,q1,q0
+    .if \rows >= 4
+    ee.vld.128.xp q3,a15,a9
+    .endif
+    .if \rows == 5
+    ee.vld.128.xp q4,a15,a9
+    ee.vmax.s8 q3,q3,q4
+    .endif
+    .if \rows >= 3
+    ee.vmax.s8 q1,q1,q2
+    .endif
+    .if \rows >= 4
+    ee.vmax.s8 q1,q1,q3
+    .endif
+    .endm
+
+    .macro stream_row pad, rows
+    // Seed all ring planes with column zero. Duplicating the first valid
+    // column leaves the max unchanged for windows clipped at the left.
+    mov.n   a12,a2
+    mov.n   a14,a5
+    add.n   a4,a2,a7
+1:
+    stream_vertical \rows
+    mov.n   a15,a14
+    ee.vst.128.xp q1,a15,a11
+    ee.vst.128.xp q1,a15,a11
+    .if \pad == 2
+    ee.vst.128.xp q1,a15,a11
+    ee.vst.128.xp q1,a15,a11
+    .endif
+    addi    a14,a14,16
+    addi    a12,a12,16
+    bltu    a12,a4,1b
+    add.n   a2,a2,a8
+    addi.n  a6,a6,-1
+
+    .if \pad == 2
+    // 5x5 needs one more valid prefix column before the first output.
+    extui   a15,a6,0,2
+    slli    a15,a15,7
+    add.n   a14,a5,a15
+    mov.n   a12,a2
+    add.n   a4,a2,a7
+2:
+    stream_vertical \rows
+    ee.vst.128.ip q1,a14,16
+    addi    a12,a12,16
+    bltu    a12,a4,2b
+    add.n   a2,a2,a8
+    addi.n  a6,a6,-1
+    .endif
+
+3:
+    mov.n   a12,a2
+    mov.n   a13,a3
+    mov.n   a14,a5
+    .if \pad == 2
+    extui   a10,a6,0,2
+    .else
+    extui   a10,a6,0,1
+    .endif
+    slli    a10,a10,7
+    add.n   a10,a5,a10
+    add.n   a4,a2,a7
+4:
+    stream_vertical \rows
+    mov.n   a15,a14
+    ee.vld.128.xp q2,a15,a11
+    ee.vld.128.xp q3,a15,a11
+    .if \pad == 2
+    ee.vld.128.xp q4,a15,a11
+    ee.vld.128.xp q5,a15,a11
+    ee.vmax.s8 q4,q4,q5
+    .endif
+    ee.vmax.s8 q2,q2,q3
+    .if \pad == 2
+    ee.vmax.s8 q2,q2,q4
+    .endif
+    ee.vst.128.ip q1,a10,16
+    ee.vmax.s8 q0,q2,q1
+    ee.vst.128.ip q0,a13,16
+    addi    a12,a12,16
+    addi    a14,a14,16
+    bltu    a12,a4,4b
+    add.n   a3,a3,a8
+    add.n   a2,a2,a8
+    addi.n  a6,a6,-1
+    bnez    a6,3b
+
+    // At the right, the latest 5x5 columns are in slots 1,2,3,0,
+    // ordered newest to oldest. The last output drops slot zero.
+    mov.n   a14,a5
+    add.n   a4,a3,a7
+    add.n   a13,a3,a8
+5:
+    mov.n   a15,a14
+    ee.vld.128.xp q2,a15,a11
+    ee.vld.128.xp q3,a15,a11
+    .if \pad == 2
+    ee.vld.128.xp q4,a15,a11
+    ee.vld.128.xp q5,a15,a11
+    ee.vmax.s8 q4,q4,q5
+    ee.vmax.s8 q3,q3,q4
+    ee.vst.128.ip q3,a13,16
+    .endif
+    ee.vmax.s8 q2,q2,q3
+    ee.vst.128.ip q2,a3,16
+    addi    a14,a14,16
+    bltu    a3,a4,5b
+    retw.n
+    .endm
+
+    .align 4
+    .global s3_maxpool_stream_asm
+    .type s3_maxpool_stream_asm,@function
+s3_maxpool_stream_asm:
+    entry   a1,64
+    l32i.n  a8,a4,LOC_CHANNELS
+    l32i.n  a9,a4,LOC_ROW_BYTES
+    l32i.n  a10,a4,LOC_ROWS
+    l8ui    a4,a4,LOC_PAD
+    movi    a11,128
+    beqi    a4,1,.Lstream3
+    beqi    a10,5,.Lstream55
+    beqi    a10,4,.Lstream54
+    stream_row 2,3
+.Lstream54:
+    stream_row 2,4
+.Lstream55:
+    stream_row 2,5
+.Lstream3:
+    beqi    a10,3,.Lstream33
+    stream_row 1,2
+.Lstream33:
+    stream_row 1,3
+    .size s3_maxpool_stream_asm,.-s3_maxpool_stream_asm
