new file mode 100644
index 0000000..1af8e49
--- /dev/null
+++ b/src/pooling/s3_maxpool_locality.S
@@ -0,0 +1,175 @@
+#include "s3_maxpool_locality.h"
+
+    .text
+
+    // q6/q7 are activation limits. The output instruction advances one pixel.
+    .macro store_pixel value, out, stride
+    ee.vmax.s8    q0,\value,q6
+    ee.vmin.s8    q0,q0,q7
+    ee.vst.128.xp q0,\out,\stride
+    .endm
+
+    .macro load_column result, ptr, rows_minus_one, stride
+    ee.vld.128.xp \result,\ptr,\stride
+    loopgtz \rows_minus_one,7f
+    ee.vld.128.xp q0,\ptr,\stride
+    ee.vmax.s8 \result,\result,q0
+7:
+    .endm
+
+    // Tile-local vector history, seeded by valid left halo columns.
+    .macro tile_body pad, history
+    movi.n  a10, -128
+    s32i.n  a10,a1,0
+    ee.vldbc.8 q2,a1
+    mv.qr   q3,q2
+    .if \pad == 2
+    mv.qr   q4,q2
+    mv.qr   q5,q2
+    .endif
+    neg     a6,a6
+1:
+    mov.n   a10,a2
+    load_column q1,a10,a9,a8
+    add.n   a2,a2,a11
+    bltz    a6,2f
+    ee.vmax.s8 q0,\history,q1
+    store_pixel q0,a3,a11
+2:
+    .if \pad == 2
+    ee.vmax.s8 q5,q4,q1
+    ee.vmax.s8 q4,q3,q1
+    .endif
+    ee.vmax.s8 q3,q2,q1
+    mv.qr   q2,q1
+    addi.n  a6,a6,1
+    addi.n  a5,a5,-1
+    bnez    a5,1b
+    beqz    a7,4f
+    .if \pad == 2
+    // A one-pixel final tile can have one remaining left-halo output to skip.
+    bltz    a6,3f
+    .endif
+    store_pixel \history,a3,a11
+    .if \pad == 2
+    beqi    a7,1,4f
+3:
+    store_pixel q4,a3,a11
+    .endif
+4:
+    retw.n
+    .endm
+
+    .align 4
+    .global s3_maxpool_tile_asm
+    .type s3_maxpool_tile_asm,@function
+s3_maxpool_tile_asm:
+    // 64-byte frame leaves the sentinel at a1+0 below the spill area.
+    entry   a1,64
+    l32i.n  a8,a4,LOC_ROW_BYTES
+    l32i.n  a9,a4,LOC_ROWS
+    addi.n  a9,a9,-1
+    l32i.n  a11,a4,LOC_CHANNELS
+    l8ui    a10,a4,LOC_PAD
+    addi    a4,a4,LOC_MIN
+    ee.vldbc.8.ip q6,a4,1
+    ee.vldbc.8 q7,a4
+    beqi    a10,1,.Ltile3
+    tile_body 2,q5
+.Ltile3:
+    tile_body 1,q3
+    .size s3_maxpool_tile_asm,.-s3_maxpool_tile_asm
+
+    // All groups in the batch of the current input column before advancing x.
+    // State layout stores two or four prefix maxima next to each other per group.
+    .macro column_body pad, history, shift, hist_offset
+    movi.n  a11,-128
+    s32i.n  a11,a1,0
+    ee.vldbc.8 q2,a1
+    slli    a4,a7,\shift
+    mov.n   a14,a5
+    add.n   a4,a5,a4
+1:
+    ee.vst.128.ip q2,a14,16
+    bltu    a14,a4,1b
+    movi.n  a11,-\pad
+2:
+    mov.n   a12,a2
+    mov.n   a13,a3
+    mov.n   a14,a5
+    add.n   a4,a2,a7
+3:
+    mov.n   a15,a12
+    load_column q1,a15,a10,a9
+    ee.vld.128.ip q2,a14,16
+    ee.vld.128.ip q3,a14,16
+    .if \pad == 2
+    ee.vld.128.ip q4,a14,16
+    ee.vld.128.ip q5,a14,16
+    .endif
+    addi    a14,a14,-(16 << \shift)
+    bltz    a11,4f
+    ee.vmax.s8 q0,\history,q1
+    ee.vmax.s8 q0,q0,q6
+    ee.vmin.s8 q0,q0,q7
+    ee.vst.128.ip q0,a13,16
+4:
+    .if \pad == 2
+    ee.vmax.s8 q5,q4,q1
+    ee.vmax.s8 q4,q3,q1
+    .endif
+    ee.vmax.s8 q3,q2,q1
+    ee.vst.128.ip q1,a14,16
+    ee.vst.128.ip q3,a14,16
+    .if \pad == 2
+    ee.vst.128.ip q4,a14,16
+    ee.vst.128.ip q5,a14,16
+    .endif
+    addi    a12,a12,16
+    bltu    a12,a4,3b
+    bltz    a11,5f
+    add.n   a3,a3,a8
+5:
+    addi.n  a11,a11,1
+    add.n   a2,a2,a8
+    addi.n  a6,a6,-1
+    bnez    a6,2b
