+/* A separate measured call keeps hardware-counter setup and MMIO out of
+ * the nine-call cycle measurement. It uses the same input and fill policy. */
+typedef struct {
+    uint32_t opt, miss, accesses, events[4];
+    bool checked;
+} pool_measurement_t;
+
+static pool_measurement_t profile_pool(const bench_case_t *c, int i, int8_t *out,
+                                       const int8_t *gold, uint32_t opt, bool timing_ok)
+{
+    uint32_t events[4];
+    const uint16_t select[2][2] = {
+        { XTPERF_CNT_INSN, XTPERF_CNT_D_STALL },
+        { XTPERF_CNT_I_STALL, XTPERF_CNT_BUBBLES },
+    };
+    const uint16_t mask[2][2] = {
+        { XTPERF_MASK_INSN_ALL, XTPERF_MASK_D_STALL_STORE_BUF_FULL },
+        { XTPERF_MASK_I_STALL_TIE_PORT, XTPERF_MASK_BUBBLES_R_HOLD_REG_DEP },
+    };
+    uint32_t miss = 0;
+    uint32_t accesses = 0;
+    bool ok = true;
+    for (int pass = 0; pass < 2; ++pass) {
+        memset(out, 0x5a, c->out_size);
+        guard_fill(out, c->out_size, 0);
+        portDISABLE_INTERRUPTS();
+        xtensa_perfmon_init(0, select[pass][0], mask[pass][0], 0, -1);
+        xtensa_perfmon_init(1, select[pass][1], mask[pass][1], 0, -1);
+        const uint32_t before_miss = REG_READ(EXTMEM_DBUS_ACS_SPIRAM_MISS_CNT_REG);
+        const uint32_t before_access = REG_READ(EXTMEM_DBUS_ACS_CNT_REG);
+        xtensa_perfmon_start();
+        c->variants[i].call(c->ctx, 0, out);
+        xtensa_perfmon_stop();
+        miss = REG_READ(EXTMEM_DBUS_ACS_SPIRAM_MISS_CNT_REG) - before_miss;
+        accesses = REG_READ(EXTMEM_DBUS_ACS_CNT_REG) - before_access;
+        events[2 * pass] = xtensa_perfmon_value(0);
+        events[2 * pass + 1] = xtensa_perfmon_value(1);
+        portENABLE_INTERRUPTS();
+        ok = (memcmp(out, gold, c->out_size) == 0 && guard_ok(out, c->out_size, 0)) && ok;
+    }
+    return (pool_measurement_t) {
+        .opt = opt, .miss = miss, .accesses = accesses,
+        .events = { events[0], events[1], events[2], events[3] },
+        .checked = ok && timing_ok,
+    };
+}
+
+static void emit_pool(const bench_case_t *c, int i, const pool_measurement_t *m)
+{
+    printf("MET %s %s %" PRIu32 " %d %" PRIu32 " %" PRIu32 " %" PRIu32
+           " %" PRIu32 " %" PRIu32 " %" PRIu32 " %s\n",
+           c->variants[i].name, c->mem == BENCH_MEM_EXT ? "ext" : "int", m->opt, m->checked,
+           m->miss, m->accesses, m->events[0], m->events[1], m->events[2], m->events[3], c->shape);
+    fflush(stdout);
+    usb_serial_jtag_wait_tx_done(pdMS_TO_TICKS(100));
+}
