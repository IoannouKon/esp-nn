+    ee.vmin.s8 q0,q0,q7
+    ee.vst.128.ip q0,a3,16
+    .if \pad == 2
+    addi    a12,a14,-80
+    ee.vld.128.ip q1,a12,0
+    ee.vmax.s8 q0,q1,q6
+    ee.vmin.s8 q0,q0,q7
+    ee.vst.128.ip q0,a15,16
+    .endif
+    bltu    a3,a4,6b
+    retw.n
+    .endm
+
+    .align 4
