+    entry   a1,64
+    l32i.n  a8,a4,LOC_CHANNELS
+    l32i.n  a9,a4,LOC_ROW_BYTES
+    l32i.n  a10,a4,LOC_ROWS
+    addi.n  a10,a10,-1
+    l8ui    a11,a4,LOC_PAD
