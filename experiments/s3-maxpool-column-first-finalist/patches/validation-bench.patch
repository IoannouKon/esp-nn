+    }
+    return mem == BENCH_MEM_EXT
+        ? esp_ptr_external_ram(input) && esp_ptr_external_ram(input + size - 1)
+        : esp_ptr_in_dram(input) && esp_ptr_in_dram(input + size - 1);
